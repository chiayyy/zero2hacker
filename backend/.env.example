# Application
APP_NAME=Zero2Hacker CTF Platform
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# Database (SQLite for local dev - no setup needed)
DATABASE_URL=sqlite:///./zero2hacker.db

# Firebase Configuration (optional - only needed for production Firebase auth)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Redis (optional)
REDIS_URL=redis://localhost:6379

# AI/Ollama (optional - needed for AI challenge generation)
OLLAMA_BASE_URL=http://localhost:11434

# CORS
ALLOWED_HOSTS=["http://localhost:3000","http://127.0.0.1:3000"]

# Docker (optional - needed for containerized challenges)
DOCKER_SOCKET=/var/run/docker.sock
CHALLENGE_NETWORK=ctf-challenges

# Challenge Settings
MAX_CHALLENGE_RUNTIME=3600
MAX_CONCURRENT_CHALLENGES=100
RATE_LIMIT_PER_MINUTE=60
