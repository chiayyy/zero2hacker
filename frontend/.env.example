# API Configuration
REACT_APP_API_URL=http://localhost:8000/api/v1

# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=zero2hacker-ctf.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=zero2hacker-ctf
REACT_APP_FIREBASE_STORAGE_BUCKET=zero2hacker-ctf.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456
REACT_APP_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# Application Configuration
REACT_APP_APP_NAME=Zero2Hacker CTF Platform
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_AI_FEATURES=true
REACT_APP_ENABLE_DARK_MODE=true